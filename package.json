{
  "name": "weekly-planner",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "pages:build": "npx @cloudflare/next-on-pages",
    "preview": "npm run pages:build && wrangler pages dev .vercel/output/static",
    "deploy": "npm run pages:build && wrangler pages deploy .vercel/output/static",
    "db:migrate:local": "wrangler d1 migrations apply weekly_planner_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply weekly_planner_db --remote",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml",
    "worker:tail": "wrangler tail --config worker/wrangler.toml"
  },
  "dependencies": {
    "jose": "^5.9.6",
    "next": "15.5.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.5",
    "@cloudflare/workers-types": "^4.20241004.0",
    "@types/node": "^20.16.11",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.3",
    "vercel": "^37.14.0",
    "wrangler": "^3.114.0"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
